# Jinja template generated by Ansible

{# Loop through each endpoint/name in endpoints #}
{% for endpoint_name, endpoint in endpoints.items() %}
{# Only if endpoint port is defined #}
{% if endpoint.port is defined %}
# Proxy for {{ endpoint_name }}.{{ networks.lan.domain.public_name }} generated by Ansible
{# Set target_host to host_ip #}
{% set target_host = hostvars[endpoint.targets[0]].host_ip %}
{# Create Caddy record ex. vault.smith-lab.xyz | reverse_proxy ip:port #}
{{ endpoint_name }}.{{ networks.lan.domain.public_name }} {
    reverse_proxy {{ target_host }}:{{ endpoint.port }} {
{# Add headers if headers = true #}
{% if endpoint.headers | default(false) %}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
{% endif %}
    }
}

{% endif %}
{% endfor %}
